# Copie para .env (nunca versione o .env). Todos os valores abaixo são exemplos.

# --- Desenvolvimento (docker-compose.yml) ------------------------------------------------------------------------------
MYSQL_DATABASE=crivosistemas
MYSQL_USER=crivosistemas
MYSQL_PASSWORD=troque-isto
MYSQL_ROOT_PASSWORD=troque-isto-tambem
MYSQL_PORT=3306

# Porta pública do app (nginx servindo o SPA e fazendo proxy de /api)
WEB_PORT=8080

# --- Produção (docker-compose.prod.yml, MySQL e Redis externos) ---------------------------------------------------------
# O compose de produção lê este arquivo inteiro como ambiente dos contêineres, então aqui os nomes são os da configuração do
# .NET (com __). O compose de desenvolvimento usa os nomes curtos (AUTH_REQUIRE_HTTPS, APP_PUBLIC_URL, SMTP_*) acima e abaixo.
# No compose de produção estas duas variáveis substituem o MySQL/Redis do compose de desenvolvimento.
ConnectionStrings__Database="Server=mysql.exemplo;Port=3306;Database=crivosistemas;User=crivosistemas;Password=troque-isto;"
# Pode apontar para o mesmo Redis do crivonft: as chaves do Crivo Gestão usam sempre o prefixo "crivosistemas:".
ConnectionStrings__Redis=redis.exemplo:6379

# true quando servido por HTTPS (produção): o cookie de sessão passa a ser só-HTTPS
AUTH_REQUIRE_HTTPS=false
Auth__RequireHttps=false

# URL pública do app (usada nos links dos e-mails), ex.: https://gestao.exemplo.com
APP_PUBLIC_URL=http://localhost:8080
App__PublicUrl=http://localhost:8080

# SMTP (host vazio = os e-mails só são escritos no log). Porta 465 -> SMTP_USE_SSL=true; 587 -> false (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Crivo Gestão
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__UseSsl=false
Smtp__FromAddress=
Smtp__FromName=Crivo Gestão

# --- Integração com o crivonft (usada em uma etapa futura; veja docs/integracao-crivonft.md) -----------------------------
# Integrations__Crivonft__BaseUrl=
# Integrations__Crivonft__Token=
# Integrations__Crivonft__HmacSecret=
# Integrations__Crivonft__ExportToken=
